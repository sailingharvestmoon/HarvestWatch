# TEMPLATE ONLY - the real file lives on the Pi at /etc/harvest-moon/ntfy.env
# and is never copied here (it holds the ntfy token).
# On the Pi:  sudo nano /etc/harvest-moon/ntfy.env
#             sudo chmod 600 /etc/harvest-moon/ntfy.env
#             sudo chown harvestmoon /etc/harvest-moon/ntfy.env
NTFY_TOPIC=your-secret-topic
NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx
