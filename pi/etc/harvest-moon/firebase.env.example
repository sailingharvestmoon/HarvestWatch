# /etc/harvest-moon/firebase.env  - the "boat systems" Firebase login.
# Lets the Pi's programs (sensors, guard, camera) write once the database rules
# are locked. Read by /home/harvestmoon/lib/fsauth.py.
#
# Create on the Pi (never in the repo):
#   sudo install -m 640 -o root -g harvestmoon /dev/null /etc/harvest-moon/firebase.env
#   sudo nano /etc/harvest-moon/firebase.env
# Test:  python3 /home/harvestmoon/lib/fsauth.py
#
# If the password has spaces or a # in it, put single quotes around it.
FB_API_KEY=AIzaSyCC_GubRIr1TV6pGHs0FgV7BoYfzQGuANE
FB_EMAIL=name+boat@example.com
FB_PASSWORD='the boat systems password'
